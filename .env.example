# Contact section visibility. Both are hidden unless set to "true".
# Copy to .env.local (or set in your host, e.g. Vercel → Settings → Environment Variables).
# These are read at build time, so redeploy after changing them.
NEXT_PUBLIC_SHOW_EMAIL=false
NEXT_PUBLIC_SHOW_LINKEDIN=false

# Website views counter (Upstash Redis). On Vercel, adding the Upstash Redis
# integration sets KV_REST_API_URL / KV_REST_API_TOKEN for you; otherwise set:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Number the views counter starts from (real visits are added on top). Default 135.
NEXT_PUBLIC_VIEWS_BASELINE=135
